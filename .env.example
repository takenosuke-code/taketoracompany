# Copy this file to .env and fill in your values.
# Do NOT commit your real .env file.
#
# Supabase: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# WordPress headless GraphQL endpoint (e.g. https://your-site.wpcomstaging.com/graphql)
WORDPRESS_GRAPHQL_ENDPOINT=

# ------------------------------------------------------------
# taketora_app（在庫管理アプリ）の Supabase — 商品カタログの参照元
#   URL:  https://<project-ref>.supabase.co（taketora_app のプロジェクト）
#   KEY:  同プロジェクトの anon キー（website_products ビューの読み取りに使用）
# 未設定の間、サイトは商品ゼロで動く（ビルドは通る）。
# ------------------------------------------------------------
TAKETORA_SUPABASE_URL=
TAKETORA_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# スマレジ・プラットフォームAPI（在庫表示用・読み取り専用）
#   スマレジ・デベロッパーズに登録したアプリの資格情報。
#   taketora_app の Edge Functions と同じアプリを使い回してよい
#   （サイトが要求するスコープは pos.stock:read のみ）。
# ------------------------------------------------------------
SMAREGI_CONTRACT_ID=
SMAREGI_CLIENT_ID=
SMAREGI_CLIENT_SECRET=
# production 以外を指定するとサンドボックス(*.smaregi.dev)につながる
SMAREGI_ENV=production
# 任意: 指定した店舗の在庫だけ表示。未指定なら全店舗の合算
SMAREGI_STORE_ID=
